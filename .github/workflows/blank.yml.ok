      - name: Fix nullable contact display names
        working-directory: ${{ env.PROJECT_DIR }}
        run: |
          python3 - <<'PY'
          from pathlib import Path

          p = Path("lib/features/chat/presentation/chats_screen.dart")
          s = p.read_text()

          s = s.replace(
              "c.displayName.trim()",
              "(c.displayName ?? '').trim()"
          )

          s = s.replace(
              "c.displayName.toLowerCase()",
              "(c.displayName ?? '').toLowerCase()"
          )

          s = s.replace(
              "_initials(c.displayName)",
              "_initials(c.displayName ?? '')"
          )

          s = s.replace(
              "Text(c.displayName, style:",
              "Text(c.displayName ?? '', style:"
          )

          p.write_text(s)
          print("Nullable displayName fixes applied.")
          PY
